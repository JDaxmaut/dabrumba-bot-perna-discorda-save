{
  // токен бота из Discord Developer Portal
  "token": "СЮДА_ТОКЕН",
  // ID сервера (ПКМ по серверу -> скопировать ID)
  "guild_id": 123456789012345678,
  // ID канала, куда бот кидает сообщение с выбором категории
  "log_channel_id": 123456789012345678,
  // путь к отслеживаемой папке (можно с \\ или /, если её нет - создаст сам ибо очень и слишком сильно супер пупер умный)
  "watch_folder": "C:\\путь\\к\\отслеживаемой\\папке",
  // как часто проверять папку, секунды
  "poll_interval_seconds": 5,
  // пауза между отправкой файлов, секунды
  "upload_delay_seconds": 0.4
}
